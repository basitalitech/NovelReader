{
    "configurations": [
        {
            "name": "Vita and host tests",
            "compilerPath": "${env:VITASDK}/bin/arm-vita-eabi-g++",
            "compileCommands": [
                "${workspaceFolder}/build/vita/compile_commands.json",
                "${workspaceFolder}/build/host/compile_commands.json"
            ],
            "includePath": [
                "${workspaceFolder}/include",
                "${env:VITASDK}/arm-vita-eabi/include",
                "${env:VITASDK}/arm-vita-eabi/include/freetype2"
            ],
            "cppStandard": "c++14",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}
