# Pinned, vendored dependencies. Configuration and builds never use the network.
file(GLOB LUA_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/third_party/lua/src/*.c")
list(REMOVE_ITEM LUA_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/third_party/lua/src/lua.c"
    "${CMAKE_CURRENT_SOURCE_DIR}/third_party/lua/src/luac.c")
add_library(novel_lua STATIC ${LUA_SOURCES})
set_source_files_properties(${LUA_SOURCES} PROPERTIES LANGUAGE CXX)
target_compile_options(novel_lua PRIVATE -include "${CMAKE_CURRENT_SOURCE_DIR}/include/lua_cpp.hpp")
target_include_directories(novel_lua PUBLIC third_party/lua/src)
target_link_libraries(novel_lua PUBLIC m)

set(MBEDTLS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/mbedtls3")
set(GEN_FILES OFF)
set(DISABLE_PACKAGE_CONFIG_AND_INSTALL ON)
add_subdirectory(third_party/mbedtls3/library)
if(NOT NOVELREADER_HOST_TESTS)
    foreach(t mbedcrypto mbedx509 mbedtls)
        target_include_directories(${t} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include")
        target_compile_definitions(${t} PUBLIC MBEDTLS_USER_CONFIG_FILE="vita_tls_config.h")
    endforeach()
    target_sources(mbedcrypto PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/vita_entropy.c")
    target_link_libraries(mbedcrypto PUBLIC SceLibKernel_stub)
    set(CMAKE_REQUIRED_LIBRARIES SceNet_stub)
    # Vita sockets use SO_NONBLOCK, not the filesystem fcntl flags.
    set(HAVE_FCNTL_O_NONBLOCK 0 CACHE BOOL "" FORCE)
    set(HAVE_PIPE2 0 CACHE BOOL "" FORCE)
endif()
set(MBEDTLS_INCLUDE_DIR "${MBEDTLS_DIR}/include")
set(MBEDTLS_LIBRARY mbedtls)
set(MBEDX509_LIBRARY mbedx509)
set(MBEDCRYPTO_LIBRARY mbedcrypto)
set(MBEDTLS_VERSION 3.6.5)
set(HAVE_MBEDTLS_DES_CRYPT_ECB 1)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
set(BUILD_MISC_DOCS OFF CACHE BOOL "" FORCE)
set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
set(CURL_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
set(CURL_ENABLE_EXPORT_TARGET OFF CACHE BOOL "" FORCE)
set(CURL_USE_OPENSSL OFF CACHE BOOL "" FORCE)
set(CURL_USE_MBEDTLS ON CACHE BOOL "" FORCE)
set(CURL_USE_LIBPSL OFF CACHE BOOL "" FORCE)
set(CURL_USE_LIBSSH2 OFF CACHE BOOL "" FORCE)
set(CURL_USE_LIBSSH OFF CACHE BOOL "" FORCE)
set(CURL_USE_GSSAPI OFF CACHE BOOL "" FORCE)
set(CURL_USE_LIBIDN2 OFF CACHE BOOL "" FORCE)
set(CURL_BROTLI OFF CACHE BOOL "" FORCE)
set(CURL_ZSTD OFF CACHE BOOL "" FORCE)
set(CURL_ZLIB OFF CACHE BOOL "" FORCE)
set(ENABLE_THREADED_RESOLVER OFF CACHE BOOL "" FORCE)
set(ENABLE_ARES OFF CACHE BOOL "" FORCE)
set(USE_NGHTTP2 OFF CACHE BOOL "" FORCE)
set(HTTP_ONLY ON CACHE BOOL "" FORCE)
set(CURL_DISABLE_LDAP ON CACHE BOOL "" FORCE)
set(CURL_DISABLE_LDAPS ON CACHE BOOL "" FORCE)
set(CURL_CA_BUNDLE "none" CACHE STRING "" FORCE)
set(CURL_CA_PATH "none" CACHE STRING "" FORCE)
add_subdirectory(third_party/curl EXCLUDE_FROM_ALL)
if(NOT NOVELREADER_HOST_TESTS)
    target_include_directories(libcurl_static PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
    target_compile_definitions(libcurl_static PRIVATE MBEDTLS_USER_CONFIG_FILE="vita_tls_config.h")
    target_link_libraries(libcurl_static PUBLIC SceNet_stub)
endif()
unset(CMAKE_REQUIRED_LIBRARIES)
